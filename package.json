{
  "name": "@rigel-cms/rigel",
  "version": "1.2.1",
  "description": "A CMS for Astro sites. You edit the text, Git keeps the history.",
  "keywords": [
    "astro",
    "astro-integration",
    "astro-component",
    "withastro",
    "cms",
    "git-based-cms",
    "svelte",
    "typescript"
  ],
  "author": {
    "name": "FreshJuice",
    "email": "contact@freshjuice.dev",
    "url": "https://freshjuice.dev/"
  },
  "contributors": [
    {
      "name": "Alex Zappa",
      "email": "alex@zappa.dev",
      "url": "https://alex.zappa.dev/"
    }
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/rigel-cms/rigel.git"
  },
  "homepage": "https://rigelcms.dev",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm typecheck",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./content": "./src/content.ts",
    "./preview": "./src/preview.ts",
    "./article": "./src/article.ts",
    "./extensions": "./src/extensions.ts",
    "./types": "./src/env.d.ts",
    "./routes/*": "./src/routes/*"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "docs/extensions.md",
    "docs/content-locales.md"
  ],
  "peerDependencies": {
    "astro": "^7.3.0",
    "svelte": "^5.57.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "astro": "^7.3.2",
    "svelte": "^5.57.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@lexical/code": "~0.52.0",
    "@lexical/history": "~0.52.0",
    "@lexical/link": "~0.52.0",
    "@lexical/list": "~0.52.0",
    "@lexical/rich-text": "~0.52.0",
    "@lexical/table": "~0.52.0",
    "dompurify": "^3.4.15",
    "lexical": "~0.52.0",
    "markdown-it": "^14.3.2",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-example-setup": "^1.2.3",
    "prosemirror-markdown": "^1.13.8",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.5"
  }
}
